<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>OcwOffline</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>OCW Offline</ApplicationTitle>
    <ApplicationId>com.mikelab.ocwoffline</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
    <!-- 24.0, not 21.0 — matches .NET 10's own shipped template default
         (avoids Java default-interface-method desugaring crashes). API 21
         still builds under .NET 10; its removal is a documented but not-yet-
         shipped .NET 11 breaking change (still in preview). See AUDIT_TRAIL v42. -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon / Splash — real assets added v23. See AUDIT_TRAIL v23. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Condition="Exists('Resources\AppIcon\appicon.svg')" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Condition="Exists('Resources\Splash\splash.svg')" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions verified live on nuget.org this round (v28) — see
         AUDIT_TRAIL v28 for the fixture/provenance per PROCESS Rule 9. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Left at 10.0.0 — nuget.org's own canonical package page confirms
         this as current (checked twice, live), but GitHub's release feed
         separately shows versions up to 14.0.0 for the same package under
         a scheme this round couldn't reconcile. Flagged, not resolved —
         see AUDIT_TRAIL v28 and HANDOFF backlog. -->
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
  </ItemGroup>

</Project>
