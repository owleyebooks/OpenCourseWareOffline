<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OcwOffline.ViewModels"
             xmlns:models="clr-namespace:OcwOffline.Models"
             x:Class="OcwOffline.Views.CatalogPage"
             x:Name="RootPage"
             x:DataType="vm:CatalogViewModel"
             Title="Browse Courses">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <Entry Grid.Row="0"
               Text="{Binding SearchText}"
               Placeholder="Filter loaded courses by title" />

        <Label Grid.Row="1" Text="{Binding StatusText}" FontAttributes="Italic" FontSize="12" />

        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding DisplayedCourses}"
                         SelectionMode="Single"
                         SelectionChanged="OnCourseSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CatalogEntry">
                    <VerticalStackLayout Padding="0,8">
                        <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3"
                Text="Load More"
                Command="{Binding LoadMoreCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

    </Grid>
</ContentPage>
