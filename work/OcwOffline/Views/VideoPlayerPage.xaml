<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:OcwOffline.Views"
             x:Class="OcwOffline.Views.VideoPlayerPage"
             Title="Lecture">
    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <views:StatusBannerView x:Name="StatusBanner" Grid.Row="0" />

        <Grid Grid.Row="1">
            <toolkit:MediaElement x:Name="Player"
                                  ShouldShowPlaybackControls="True"
                                  ShouldAutoPlay="False"
                                  MediaOpened="OnMediaOpened"
                                  MediaFailed="OnMediaFailed" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <VerticalStackLayout x:Name="ErrorPanel"
                                 IsVisible="False"
                                 VerticalOptions="Center"
                                 Padding="32"
                                 Spacing="16">
                <Label Text="This video couldn't be played. The file may be damaged. Try downloading it again when you're back online."
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
                <Button Text="Back to lectures"
                        Clicked="OnBackToLecturesClicked"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Used only for the missing-file branches now; the spinner and
             the error panel cover every other state. -->
        <Label x:Name="StatusLabel"
               Grid.Row="2"
               Padding="16,8"
               FontSize="12"
               Opacity="0.7" />

    </Grid>
</ContentPage>
