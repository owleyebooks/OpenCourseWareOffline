<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OcwOffline.Views.AboutPage"
             Title="About">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="OCW Offline" FontAttributes="Bold" FontSize="24" />
            <Label x:Name="VersionLabel" FontSize="12" Opacity="0.7" />

            <Label Text="Course content is provided by MIT OpenCourseWare (ocw.mit.edu) and is licensed under Creative Commons Attribution-NonCommercial-ShareAlike (CC BY-NC-SA)."
                   LineBreakMode="WordWrap" />
            <Label Text="This app is not affiliated with or endorsed by MIT."
                   LineBreakMode="WordWrap" />

            <Button Text="Privacy Policy" Clicked="OnPrivacyPolicyClicked" />
            <Button Text="Contribute on GitHub" Clicked="OnContributeClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
