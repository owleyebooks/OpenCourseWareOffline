<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OcwOffline.Views"
             x:Class="OcwOffline.Views.AboutPage"
             Title="About">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <views:StatusBannerView x:Name="StatusBanner" />

            <Label Text="About this app" FontAttributes="Bold" FontSize="18" />
            <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                <Label Text="OCW Offline" FontAttributes="Bold" FontSize="24" />
                <Label x:Name="VersionLabel" FontSize="12" Opacity="0.7" />
                <Label Text="Downloads MIT OpenCourseWare courses so you can watch them offline."
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Label Text="Course content license" FontAttributes="Bold" FontSize="18" />
            <Label Text="Course content is provided by MIT OpenCourseWare (ocw.mit.edu) and is licensed under Creative Commons Attribution-NonCommercial-ShareAlike (CC BY-NC-SA)."
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,8" />

            <Label Text="Not affiliated with MIT" FontAttributes="Bold" FontSize="18" />
            <Frame BorderColor="#B9CDE6"
                   BackgroundColor="#F2F6FB"
                   CornerRadius="8"
                   Padding="12"
                   HasShadow="False"
                   Margin="0,0,0,8">
                <Label Text="This app is not affiliated with or endorsed by MIT."
                       LineBreakMode="WordWrap" />
            </Frame>

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,8" />

            <Button Text="Privacy Policy" Clicked="OnPrivacyPolicyClicked" />
            <Label Text="Found a problem or want a feature? The app is open source."
                   LineBreakMode="WordWrap"
                   Margin="0,8,0,0" />
            <Button Text="Help improve this app" Clicked="OnHelpImproveClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
