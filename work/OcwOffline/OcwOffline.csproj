<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>OcwOffline</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>OCW Offline</ApplicationTitle>
    <ApplicationId>com.owleyebooks.ocwoffline</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
    <!-- Android min API 26, not 24: CommunityToolkit.Maui.MediaElement's
         Android backend is only supported on API 26+, so the manifest
         floor matches what the app already requires at startup. API 26
         (Android 8.0, 2017) also keeps the .NET 10 template's reason for
         avoiding 21: no Java default-interface-method desugaring crashes. -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26.0</SupportedOSPlatformVersion>
    <!-- TEMPORARY diagnostic bisect (screenshot-run branch only): .NET 10
         enables marshal methods by default, and Microsoft's own docs say
         hangs at startup are the known symptom. If the blank-screen hang
         clears with this off, the root cause is the marshal-methods
         regression, not our code. Removed before merging to main. -->
    <AndroidEnableMarshalMethods Condition="'$(TargetFramework)' == 'net10.0-android'">false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Condition="Exists('Resources\AppIcon\appicon.svg')" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Condition="Exists('Resources\Splash\splash.svg')" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Stays at 10.0.0: nuget.org's canonical package page lists it as
         current, while GitHub's release feed shows higher versions under
         a versioning scheme that does not match the nuget listing. Do not
         bump from the GitHub feed without reconciling the scheme. -->
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <!-- Provides builder.Logging.AddDebug() used in MauiProgram's #if DEBUG
         block (same package the stock MAUI template references). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

</Project>
